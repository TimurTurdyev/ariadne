{
    "name": "timurturdyev/simple-search",
    "description": "Faceted filter and search for Laravel: query plan, facet panel with ready links, URL codec, SQL facets without a search engine and zero-downtime Manticore table rebuild.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "manticore",
        "search",
        "faceted-search",
        "facets",
        "filter"
    ],
    "authors": [
        {
            "name": "Timur Turdyev",
            "email": "borodatimur@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "illuminate/cache": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-intl": "Collator-based natural ordering of facet values.",
        "ext-pdo_mysql": "Required by the Manticore connection: Manticore speaks the MySQL protocol."
    },
    "autoload": {
        "psr-4": {
            "TimurTurdyev\\SimpleSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TimurTurdyev\\SimpleSearch\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TimurTurdyev\\SimpleSearch\\SimpleSearchServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
