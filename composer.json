{
    "name": "timurturdyev/ariadne",
    "description": "Faceted catalog navigation for Laravel: disjunctive facet counts, a filter panel with ready links, canonical URLs, SQL facets on your own database and zero-downtime Manticore rebuilds.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "manticore",
        "search",
        "faceted-search",
        "faceted-navigation",
        "facets",
        "filter",
        "catalog"
    ],
    "authors": [
        {
            "name": "Timur Turdyev",
            "email": "borodatimur@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "ext-intl": "Collator-based natural ordering of facet values.",
        "ext-pdo_mysql": "Required by the Manticore connection: Manticore speaks the MySQL protocol."
    },
    "autoload": {
        "psr-4": {
            "TimurTurdyev\\Ariadne\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TimurTurdyev\\Ariadne\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TimurTurdyev\\Ariadne\\AriadneServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
